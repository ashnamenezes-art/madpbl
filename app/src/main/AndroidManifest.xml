<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.smartbus.app">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Location -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- Notifications -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".SmartBusApplication"
        android:allowBackup="true"
        android:icon="@drawable/ic_bus"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_bus"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true">

        <!-- MAIN LAUNCHER -->
        <activity
            android:name=".activities.SplashActivity"
            android:exported="true"
            android:theme="@style/SplashTheme">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".activities.RoleSelectionActivity" android:exported="false" />

        <!-- Passenger Activities -->
        <activity android:name=".activities.passenger.PassengerLoginActivity" android:exported="false" />
        <activity android:name=".activities.passenger.PassengerRegisterActivity" android:exported="false" />
        <activity android:name=".activities.passenger.PassengerHomeActivity" android:exported="false" />
        <activity android:name=".activities.passenger.BusSearchActivity" android:exported="false" />
        <activity android:name=".activities.passenger.BusListActivity" android:exported="false" />
        <activity android:name=".activities.passenger.LiveTrackingActivity" android:exported="false" />
        <activity android:name=".activities.passenger.TicketActivity" android:exported="false" />
        <activity android:name=".activities.passenger.SosActivity" android:exported="false" />
        <activity android:name=".activities.passenger.FeedbackActivity" android:exported="false" />
        <activity android:name=".activities.passenger.ProfileActivity" android:exported="false" />

        <!-- Driver Activities -->
        <activity android:name=".activities.driver.DriverLoginActivity" android:exported="false" />
        <activity android:name=".activities.driver.DriverHomeActivity" android:exported="false" />
        <activity android:name=".activities.driver.DriverProfileActivity" android:exported="false" />
        <activity android:name=".activities.driver.DriverMapActivity" android:exported="false" />

        <!-- Admin Activities -->
        <activity android:name=".activities.admin.AdminLoginActivity" android:exported="false" />
        <activity android:name=".activities.admin.AdminDashboardActivity" android:exported="false" />
        <activity android:name=".activities.admin.ManageBusesActivity" android:exported="false" />
        <activity android:name=".activities.admin.ManageDriversActivity" android:exported="false" />
        <activity android:name=".activities.admin.ManageRoutesActivity" android:exported="false" />
        <activity android:name=".activities.admin.ManageStopsActivity" android:exported="false" />
        <activity android:name=".activities.admin.ViewComplaintsActivity" android:exported="false" />
        <activity android:name=".activities.admin.AdminLiveMapActivity" android:exported="false" />

        <!-- Services -->
        <service
            android:name=".services.LocationUpdateService"
            android:exported="false"
            android:foregroundServiceType="location" />

    </application>
</manifest>
