<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base Application Theme -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/status_bar</item>
        <item name="android:navigationBarColor">@color/primary_dark</item>
        <item name="materialButtonStyle">@style/Widget.App.Button.Primary</item>
    </style>

    <!-- Splash Theme (no action bar, no title bar) -->
    <style name="SplashTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_splash</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>

    <!-- Passenger Theme -->
    <style name="PassengerTheme" parent="AppTheme">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
    </style>

    <!-- Driver Theme -->
    <style name="DriverTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/driver_color</item>
        <item name="colorPrimaryDark">#1B5E20</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">#1B5E20</item>
        <item name="materialButtonStyle">@style/Widget.App.Button.Green</item>
    </style>

    <!-- Admin Theme -->
    <style name="AdminTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/admin_color</item>
        <item name="colorPrimaryDark">#4A148C</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">#4A148C</item>
        <item name="materialButtonStyle">@style/Widget.App.Button.Purple</item>
    </style>

    <!-- Toolbar Style -->
    <style name="AppToolbar" parent="Widget.AppCompat.Toolbar">
        <item name="android:background">@color/primary</item>
        <item name="android:minHeight">@dimen/toolbar_height</item>
        <item name="titleTextColor">@color/white</item>
        <item name="subtitleTextColor">@color/light_gray</item>
        <item name="popupTheme">@style/ThemeOverlay.AppCompat.Light</item>
    </style>

    <style name="DriverToolbar" parent="AppToolbar">
        <item name="android:background">@color/driver_color</item>
    </style>

    <style name="AdminToolbar" parent="AppToolbar">
        <item name="android:background">@color/admin_color</item>
    </style>

    <!-- Button Styles -->
    <style name="Widget.App.Button.Primary" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/primary</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">@dimen/text_large</item>
        <item name="android:letterSpacing">0.05</item>
    </style>

    <style name="Widget.App.Button.Green" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/driver_color</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.Button.Purple" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/admin_color</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.App.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">12dp</item>
        <item name="strokeColor">@color/primary</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <style name="Widget.App.Button.SOS" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">12dp</item>
        <item name="backgroundTint">@color/sos_red</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">18sp</item>
    </style>

    <!-- Card Style -->
    <style name="AppCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="cardBackgroundColor">@color/card_background</item>
        <item name="contentPaddingLeft">@dimen/margin_medium</item>
        <item name="contentPaddingRight">@dimen/margin_medium</item>
        <item name="contentPaddingTop">@dimen/margin_medium</item>
        <item name="contentPaddingBottom">@dimen/margin_medium</item>
    </style>

    <!-- Input Field Style -->
    <style name="AppTextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">8dp</item>
        <item name="boxCornerRadiusTopEnd">8dp</item>
        <item name="boxCornerRadiusBottomStart">8dp</item>
        <item name="boxCornerRadiusBottomEnd">8dp</item>
        <item name="boxStrokeColor">@color/primary</item>
        <item name="hintTextColor">@color/primary</item>
    </style>

    <!-- Text Styles -->
    <style name="TextAppearance.App.Title" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="TextAppearance.App.Header" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/text_header</item>
        <item name="android:fontFamily">sans-serif-bold</item>
    </style>

    <style name="TextAppearance.App.Body" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/text_medium</item>
    </style>

</resources>
